<?xml version="1.0" encoding="utf-8"?>
<!-- Two states: wait for the player, then spawn the first wave of the reference map (spawn points 101-103).
     The file name must match a TriggerModel in the xblock: this one is XmlFilePath mobspawn_11 (id 11). -->
<ms2>
   <state name="wait">
        <onEnter>
        </onEnter>
            <condition name="CheckUser">
                <transition state="fight"/>
            </condition>
    </state>

   <state name="fight">
        <onEnter>
            <action name="SpawnMonster" arg1="101,102,103" arg2="0"/>
            <action name="SetEventUI" arg1="1" arg2="Custom trigger: fight!" arg3="4000" arg4="0"/>
        </onEnter>
    </state>
</ms2>
