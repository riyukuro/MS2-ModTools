<?xml version="1.0" encoding="utf-8"?>
<!-- 52900001_cd custom proof trigger : banner after entry, then spawn the three thugs (601-603). -->
<ms2>
   <state name="idle">
        <onEnter>
            <action name="SetPortal" arg1="1" arg2="1" arg3="1" arg4="1"/>
        </onEnter>
            <condition name="CheckUser">
                <transition state="greet"/>
            </condition>
    </state>

   <state name="greet">
        <onEnter>
        </onEnter>
            <condition name="WaitTick" waitTick="5000">
                <transition state="banner"/>
            </condition>
    </state>

   <state name="banner">
        <onEnter>
            <action name="PlaySystemSoundInBox" arg2="System_ShowGuideSummary_01"/>
            <action name="SetEventUI" arg1="1" arg2="Custom trigger: thugs incoming in 5 seconds" arg3="5000" arg4="0"/>
        </onEnter>
            <condition name="WaitTick" waitTick="5000">
                <transition state="spawn"/>
            </condition>
    </state>

   <state name="spawn">
        <onEnter>
            <action name="SpawnMonster" arg1="601,602,603" arg2="0"/>
            <action name="SetEventUI" arg1="1" arg2="Custom trigger: thugs spawned" arg3="4000" arg4="0"/>
        </onEnter>
            <condition name="MonsterDead" arg1="601,602,603">
                <transition state="cleared"/>
            </condition>
    </state>

   <state name="cleared">
        <onEnter>
            <action name="SetEventUI" arg1="1" arg2="Custom trigger: cleared" arg3="4000" arg4="0"/>
        </onEnter>
    </state>
</ms2>
