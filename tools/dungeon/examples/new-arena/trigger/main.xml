<?xml version="1.0" encoding="utf-8"?>
<ms2>
	<state name="Wait">
		<onEnter>
			<action name="SetPortal" arg1="1" arg2="0" arg3="0" arg4="0"/>
		</onEnter>
		<condition name="CheckUser">
			<transition state="Intro"/>
		</condition>
	</state>
	<state name="Intro">
		<onEnter>
			<action name="SetEventUI" arg1="1" arg2="Clear the yard to open the way out." arg3="4000" arg4="0"/>
		</onEnter>
		<condition name="WaitTick" waitTick="3000">
			<transition state="Fight"/>
		</condition>
	</state>
	<state name="Fight">
		<onEnter>
			<action name="SpawnMonster" arg1="101,102,103" arg2="0"/>
		</onEnter>
		<condition name="MonsterDead" arg1="101,102,103">
			<transition state="Cleared"/>
		</condition>
	</state>
	<state name="Cleared">
		<onEnter>
			<action name="SetPortal" arg1="1" arg2="1" arg3="1" arg4="1"/>
			<action name="SetEventUI" arg1="1" arg2="The way out is open." arg3="4000" arg4="0"/>
			<action name="DungeonClear"/>
		</onEnter>
	</state>
</ms2>
