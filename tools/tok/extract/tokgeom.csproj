<Project Sdk="Microsoft.NET.Sdk">
  <!-- PathEngine-free: reads MapleStory2 map data and writes a .geom/.solids dump (see ../README.md, ../FORMAT.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>CS8632</NoWarn>
    <!-- unpatched Win10 kills CET-marked .NET apps with "Your Windows doesn't fully support CET" (0x80131506) -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Maple2.File.Parser.Tadeucci" Version="2.3.7" />
  </ItemGroup>
</Project>
